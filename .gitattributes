# Enforce LF line endings for all source files to prevent cross-platform issues
* text=auto eol=lf

# Python
*.py text eol=lf

# Config / markup
*.toml text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.env  text eol=lf
Dockerfile text eol=lf
Caddyfile  text eol=lf

# Binaries
*.png binary
*.jpg binary
*.ico binary
