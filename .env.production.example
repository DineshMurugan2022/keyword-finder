# Production environment — copy to .env.production, fill in all values, never commit it.

# ── OpenAI (for ADK chat; not needed for CLI or API) ──────────────────────────
OPENAI_API_KEY=sk-...
AGENT_MODEL=openai/gpt-6-astra

# ── SerpAPI (required for ranking checks) ─────────────────────────────────────
# Sign up at https://serpapi.com, free plan: 100 searches/month
SERPAPI_KEY=

# ── Database ───────────────────────────────────────────────────────────────────
# Set by docker-compose via environment: block; leave blank here for compose use.
# For standalone deployment: postgresql+psycopg://user:pass@host:5432/dbname
RANK_DATABASE_URL=

# PostgreSQL password — also referenced in docker-compose.yml
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# ── Storage ────────────────────────────────────────────────────────────────────
RANK_DATA_DIR=/app/data

# Optional S3 evidence backup
# AWS credentials must be available (IAM role recommended; or set AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY)
RANK_S3_BUCKET=
RANK_S3_PREFIX=ranking-evidence

# ── HTTP API token ─────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
RANK_API_TOKEN=

# ── Scheduler ──────────────────────────────────────────────────────────────────
RANK_SCHEDULER_HOUR=2
RANK_SCHEDULER_MINUTE=0

# ── Browser (demo only — not used in production) ───────────────────────────────
RANK_HEADLESS=true

# ── AWS (only needed if RANK_S3_BUCKET is set and not using an IAM role) ───────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-south-1
