# Copy to ranking_agent/.env and enter credentials locally; never commit it.
OPENAI_API_KEY=
AGENT_MODEL=openai/gpt-6-astra
# Pin a tested model identifier before production rollout.

# --- SerpAPI (required for production checks) ---
# Sign up at https://serpapi.com and paste your API key here.
SERPAPI_KEY=

# --- Data / Database ---
RANK_DATA_DIR=./data
# Defaults to local SQLite. For deployment use postgresql+psycopg://...
RANK_DATABASE_URL=
RANK_HEADLESS=true

# --- HTTP API (required only for the HTTP API) ---
# Generate a random value with at least 32 characters.
RANK_API_TOKEN=

# --- Optional: S3 evidence storage ---
# Leave blank to store evidence on local disk only.
# Set to upload evidence to s3://<bucket>/<prefix>/<run_id>/ after each check.
RANK_S3_BUCKET=
RANK_S3_PREFIX=ranking-evidence

# --- Daily scheduler ---
# Time-of-day (server local time) at which the scheduler enqueues the daily check.
RANK_SCHEDULER_HOUR=2
RANK_SCHEDULER_MINUTE=0
